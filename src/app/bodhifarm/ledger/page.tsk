'use client';

import { useEffect, useMemo, useState } from 'react';
import { createClient } from '../../../lib/supabase/client';

type Farmer = {
  id: string;
  farmer_id: string;
  full_name: string;
  mobile?: string | null;
};

type Summary = {
  farmer_id: string;
  farmer_code: string | null;
  full_name: string | null;
  egg_earnings: number | null;
  expenses: number | null;
  payments: number | null;
  outstanding_balance: number | null;
};

type LedgerEntry = {
  id: string;
  farmer_id: string;
  entry_date: string;
  entry_type: string;
  reference_id: string | null;
  description: string | null;
  debit: number | null;
  credit: number | null;
};

export default function FarmerLedgerPage() {
  const supabase = createClient();

  const [farmers, setFarmers] = useState<Farmer[]>([]);
  const [summaries, setSummaries] = useState<Summary[]>([]);
  const [entries, setEntries] = useState<LedgerEntry[]>([]);
  const [selectedFarmer, setSelectedFarmer] = useState('');
  const [loading, setLoading] = useState(true);
  const [ledgerLoading, setLedgerLoading] = useState(false);
  const [error, setError] = useState('');

  async function loadBase() {
    setLoading(true);
    setError('');

    const [farmersRes, summaryRes] = await Promise.all([
      supabase
        .from('farmers')
        .select('id, farmer_id, full_name, mobile')
        .eq('status', 'ACTIVE')
        .order('farmer_id'),
      supabase
        .from('farmer_finance_summary')
        .select('*')
        .order('farmer_code'),
    ]);

    if (farmersRes.error) {
      setError(farmersRes.error.message);
      setLoading(false);
      return;
    }

    if (summaryRes.error) {
      setError(summaryRes.error.message);
      setLoading(false);
      return;
    }

    setFarmers(farmersRes.data || []);
    setSummaries((summaryRes.data || []) as Summary[]);

    if (!selectedFarmer && farmersRes.data?.length) {
      setSelectedFarmer(farmersRes.data[0].id);
    }

    setLoading(false);
  }

  async function loadLedger(farmerId: string) {
    if (!farmerId) {
      setEntries([]);
      return;
    }

    setLedgerLoading(true);
    setError('');

    const { data, error } = await supabase
      .from('farmer_ledger_entries')
      .select(
        'id, farmer_id, entry_date, entry_type, reference_id, description, debit, credit'
      )
      .eq('farmer_id', farmerId)
      .order('entry_date', { ascending: true })
      .order('created_at', { ascending: true });

    if (error) {
      setError(error.message);
      setEntries([]);
    } else {
      setEntries((data || []) as LedgerEntry[]);
    }

    setLedgerLoading(false);
  }

  useEffect(() => {
    loadBase();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    loadLedger(selectedFarmer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedFarmer]);

  const selectedSummary = useMemo(
    () => summaries.find((s) => s.farmer_id === selectedFarmer),
    [summaries, selectedFarmer]
  );

  const selectedFarmerData = useMemo(
    () => farmers.find((f) => f.id === selectedFarmer),
    [farmers, selectedFarmer]
  );

  const ledgerRows = useMemo(() => {
    let balance = 0;

    return entries.map((entry) => {
      const credit = Number(entry.credit || 0);
      const debit = Number(entry.debit || 0);
      balance += credit - debit;

      return { ...entry, runningBalance: balance };
    });
  }, [entries]);

  const totals = useMemo(() => {
    const credit = entries.reduce((sum, e) => sum + Number(e.credit || 0), 0);
    const debit = entries.reduce((sum, e) => sum + Number(e.debit || 0), 0);
    return {
      credit,
      debit,
      balance: credit - debit,
    };
  }, [entries]);

  function money(value: number | null | undefined) {
    return `₹${Number(value || 0).toLocaleString('en-IN', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    })}`;
  }

  function formatDate(value: string) {
    return new Date(`${value}T00:00:00`).toLocaleDateString('en-IN', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    });
  }

  async function refresh() {
    await loadBase();
    if (selectedFarmer) await loadLedger(selectedFarmer);
  }

  return (
    <main className="min-h-screen bg-slate-50 p-4 md:p-8">
      <div className="mx-auto max-w-7xl">
        <div className="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <div className="text-sm font-semibold text-green-700">BodhiFarm</div>
            <h1 className="text-3xl font-bold text-slate-900">
              Farmer Ledger & Settlement
            </h1>
            <p className="mt-1 text-sm text-slate-600">
              Farmer-wise earnings, recoveries, payments and running balance.
            </p>
          </div>

          <div className="flex gap-2">
            <button
              onClick={refresh}
              className="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100"
            >
              Refresh
            </button>
            <button
              onClick={() => window.print()}
              className="rounded-lg bg-green-700 px-4 py-2 text-sm font-semibold text-white hover:bg-green-800"
            >
              Print Statement
            </button>
          </div>
        </div>

        {error && (
          <div className="mb-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            {error}
          </div>
        )}

        {loading ? (
          <div className="rounded-xl border bg-white p-8 text-center text-slate-500">
            Loading farmer ledger...
          </div>
        ) : (
          <>
            <section className="mb-6 rounded-xl border bg-white p-5 shadow-sm">
              <label className="mb-2 block text-sm font-semibold text-slate-700">
                Select Farmer
              </label>
              <select
                value={selectedFarmer}
                onChange={(e) => setSelectedFarmer(e.target.value)}
                className="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm outline-none focus:border-green-600 md:max-w-xl"
              >
                {farmers.map((farmer) => (
                  <option key={farmer.id} value={farmer.id}>
                    {farmer.farmer_id} — {farmer.full_name}
                  </option>
                ))}
              </select>
            </section>

            <section className="mb-6 grid grid-cols-1 gap-4 md:grid-cols-4">
              <div className="rounded-xl border bg-white p-5 shadow-sm">
                <div className="text-xs font-semibold uppercase text-slate-500">
                  Egg Earnings
                </div>
                <div className="mt-2 text-2xl font-bold text-green-700">
                  {money(selectedSummary?.egg_earnings)}
                </div>
              </div>

              <div className="rounded-xl border bg-white p-5 shadow-sm">
                <div className="text-xs font-semibold uppercase text-slate-500">
                  Expenses / Recoveries
                </div>
                <div className="mt-2 text-2xl font-bold text-red-600">
                  {money(selectedSummary?.expenses)}
                </div>
              </div>

              <div className="rounded-xl border bg-white p-5 shadow-sm">
                <div className="text-xs font-semibold uppercase text-slate-500">
                  Payments Made
                </div>
                <div className="mt-2 text-2xl font-bold text-blue-700">
                  {money(selectedSummary?.payments)}
                </div>
              </div>

              <div className="rounded-xl border bg-white p-5 shadow-sm">
                <div className="text-xs font-semibold uppercase text-slate-500">
                  Outstanding Balance
                </div>
                <div className="mt-2 text-2xl font-bold text-slate-900">
                  {money(selectedSummary?.outstanding_balance)}
                </div>
              </div>
            </section>

            <section className="mb-6 rounded-xl border bg-white p-5 shadow-sm">
              <div className="flex flex-col gap-2 border-b pb-4 md:flex-row md:items-center md:justify-between">
                <div>
                  <h2 className="text-xl font-bold text-slate-900">
                    Farmer Statement
                  </h2>
                  <p className="text-sm text-slate-600">
                    {selectedFarmerData?.farmer_id} — {selectedFarmerData?.full_name}
                    {selectedFarmerData?.mobile
                      ? ` — ${selectedFarmerData.mobile}`
                      : ''}
                  </p>
                </div>
                <div className="text-sm text-slate-500">
                  {ledgerRows.length} ledger entries
                </div>
              </div>

              {ledgerLoading ? (
                <div className="py-10 text-center text-slate-500">
                  Loading ledger...
                </div>
              ) : ledgerRows.length === 0 ? (
                <div className="py-10 text-center text-slate-500">
                  No ledger entries found for this farmer.
                </div>
              ) : (
                <div className="mt-4 overflow-x-auto">
                  <table className="min-w-full text-sm">
                    <thead>
                      <tr className="border-b text-left text-xs uppercase text-slate-500">
                        <th className="px-3 py-3">Date</th>
                        <th className="px-3 py-3">Type</th>
                        <th className="px-3 py-3">Description</th>
                        <th className="px-3 py-3 text-right">Credit</th>
                        <th className="px-3 py-3 text-right">Debit</th>
                        <th className="px-3 py-3 text-right">Balance</th>
                      </tr>
                    </thead>
                    <tbody>
                      {ledgerRows.map((entry) => (
                        <tr key={entry.id} className="border-b last:border-0">
                          <td className="px-3 py-3 text-slate-700">
                            {formatDate(entry.entry_date)}
                          </td>
                          <td className="px-3 py-3 font-semibold text-slate-800">
                            {entry.entry_type.replaceAll('_', ' ')}
                          </td>
                          <td className="px-3 py-3 text-slate-600">
                            {entry.description || '—'}
                          </td>
                          <td className="px-3 py-3 text-right font-semibold text-green-700">
                            {Number(entry.credit || 0) > 0
                              ? money(entry.credit)
                              : '—'}
                          </td>
                          <td className="px-3 py-3 text-right font-semibold text-red-600">
                            {Number(entry.debit || 0) > 0
                              ? money(entry.debit)
                              : '—'}
                          </td>
                          <td className="px-3 py-3 text-right font-bold text-slate-900">
                            {money(entry.runningBalance)}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                    <tfoot>
                      <tr className="border-t-2">
                        <td colSpan={3} className="px-3 py-4 font-bold">
                          TOTAL
                        </td>
                        <td className="px-3 py-4 text-right font-bold text-green-700">
                          {money(totals.credit)}
                        </td>
                        <td className="px-3 py-4 text-right font-bold text-red-600">
                          {money(totals.debit)}
                        </td>
                        <td className="px-3 py-4 text-right font-bold">
                          {money(totals.balance)}
                        </td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              )}
            </section>

            <section className="rounded-xl border bg-white p-5 shadow-sm">
              <h2 className="text-lg font-bold text-slate-900">
                Settlement Summary
              </h2>

              <div className="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
                <div className="rounded-lg bg-green-50 p-4">
                  <div className="text-xs font-semibold uppercase text-green-700">
                    Total Credit
                  </div>
                  <div className="mt-1 text-xl font-bold text-green-800">
                    {money(totals.credit)}
                  </div>
                </div>

                <div className="rounded-lg bg-red-50 p-4">
                  <div className="text-xs font-semibold uppercase text-red-700">
                    Total Debit
                  </div>
                  <div className="mt-1 text-xl font-bold text-red-800">
                    {money(totals.debit)}
                  </div>
                </div>

                <div className="rounded-lg bg-slate-100 p-4">
                  <div className="text-xs font-semibold uppercase text-slate-600">
                    Closing Balance
                  </div>
                  <div className="mt-1 text-xl font-bold text-slate-900">
                    {money(totals.balance)}
                  </div>
                </div>
              </div>
            </section>
          </>
        )}
      </div>

      <style jsx global>{`
        @media print {
          body {
            background: white !important;
          }
          button,
          select {
            display: none !important;
          }
          .shadow-sm {
            box-shadow: none !important;
          }
        }
      `}</style>
    </main>
  );
}

