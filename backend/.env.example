# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Configure only after SQL Server is installed and reachable.
SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=BodhiRuralDev
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=no
