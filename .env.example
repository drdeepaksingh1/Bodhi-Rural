# Copy this file to .env.local and set values from your Supabase project.
# Do not commit .env.local or place privileged secrets in NEXT_PUBLIC_* variables.

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (Project Settings -> API)
# This key is intended for browser use; protect data with RLS and database authorization.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay payment gateway. Keep secrets server-side; never prefix these with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron authorization for automatic release of unpaid stock reservations.
CRON_SECRET=
